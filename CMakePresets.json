{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Config",
            "description": "Using vcpkg toolchain file, clang compiler and Ninja generator",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug Config",
            "description": "Debug build configuration",
            "inherits": "default",
            "binaryDir": "${sourceDir}/cmake-build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release Config",
            "description": "Release build configuration",
            "inherits": "default",
            "binaryDir": "${sourceDir}/cmake-build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name" : "debug-with-tests",
            "displayName" : "Debug Test Config",
            "description" : "Debug Test build configuration",
            "inherits" : "default",
            "binaryDir" : "${sourceDir}/cmake-build-debug",
            "cacheVariables" : {
                "CMAKE_BUILD_TYPE" : "Debug",
                "BUILD_TESTING" : "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "displayName": "Build Debug",
            "jobs": 4
        },
        {
            "name": "release",
            "configurePreset": "release",
            "displayName": "Build Release",
            "jobs": 8
        }
    ],
    "testPresets": [
        {
            "name": "test",
            "configurePreset": "debug-with-tests",
            "displayName": "Run Tests",
            "output": {
                "outputOnFailure": true,
                "verbosity": "verbose"
            }
        }
    ]
}